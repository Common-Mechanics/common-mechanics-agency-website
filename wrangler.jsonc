{
	"compatibility_date": "2026-05-29",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "common-mechanics-agency-website",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Disabled deliberately: this is a static marketing site with no server-side
	// logic to debug, and Workers observability retains request logs (including
	// client IPs) in Cloudflare's pipeline. Leaving it off is data minimisation
	// under UK GDPR Art. 5(1)(c) — it removes the processing rather than
	// documenting it. Re-enable only alongside a retention period and a
	// corresponding line in /privacy — `npm run check-privacy` fails the build
	// while this says true and that page still claims we keep no logs.
	"observability": {
		"enabled": false
	}
}