    background: var(--color-accent);  /* bold orange flair */
    color: var(--color-bg);           /* off-white copy */

    /* Concave corner scoops, like the wordmark badge, sized to roughly match
       the section frame's corner cutouts. */
    --notch: var(--frame-gap);
    -webkit-mask:
      radial-gradient(var(--notch) at top left,     #0000 98%, #000) top left,
      radial-gradient(var(--notch) at top right,    #0000 98%, #000) top right,
      radial-gradient(var(--notch) at bottom left,  #0000 98%, #000) bottom left,
      radial-gradient(var(--notch) at bottom right, #0000 98%, #000) bottom right;
    -webkit-mask-size: 51% 51%;  /* >50% so quadrants overlap and hide the centre seam */
    -webkit-mask-repeat: no-repeat;
    mask:
      radial-gradient(var(--notch) at top left,     #0000 98%, #000) top left,
      radial-gradient(var(--notch) at top right,    #0000 98%, #000) top right,
      radial-gradient(var(--notch) at bottom left,  #0000 98%, #000) bottom left,
      radial-gradient(var(--notch) at bottom right, #0000 98%, #000) bottom right;
    mask-size: 51% 51%;  /* >50% so quadrants overlap and hide the centre seam */
    mask-repeat: no-repeat;
  }

  /* Stack the legal line, the registered address and the contact row */
  .footer-copy,
  .footer-address,
  .footer-contact {
    display: block;
  }

  .footer-address {
    opacity: 0.8;
  }

  /* Statutory contact route (E-Commerce Regs 2002, reg. 6) and the privacy
     notice required by UK GDPR Art. 13. Kept at full opacity — these have to
     stay findable, so they don't get the address line's softening. */
  .footer-contact {
    margin-top: var(--space-2);
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    /* See the note in Team.astro: enlarged browser text must break rather
       than widen the page. */
    overflow-wrap: anywhere;
  }

  /* The global link rule underlines in --color-muted, which is near-invisible
     on the orange band; carry the footer's own colour instead. */
  .footer-contact a {
    color: inherit;
    text-decoration-color: currentColor;
  }

  .footer-contact a:hover,
  .footer-contact a:focus-visible {
    text-decoration-thickness: 2px;
  }

  .footer-contact a:focus-visible {
    outline: 2px solid var(--color-bg);
    outline-offset: 3px;
  }

  /* Solid orange block — drop the architectural frame rails here */
  .footer-section::before {
    content: none;
  }
</style>
