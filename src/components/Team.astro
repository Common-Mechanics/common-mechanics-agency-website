---
interface Member {
  name: string;
  email: string;
  linkedin: string;
  location: string;
}

const members: Member[] = [
  {
    name: 'Taylor Jones',
    email: 'taylor@commonmechanics.io',
    linkedin: 'https://www.linkedin.com/in/tjonesdesigner/',
    location: 'London, UK',
  },
  {
    name: 'Alexander Haase',
    email: 'alex@commonmechanics.io',
    linkedin: 'https://www.linkedin.com/in/herrhaase/?locale=en',
    location: 'Berlin, DE',
  },
  {
    name: 'Max Werner',
    email: 'max@commonmechanics.io',
    linkedin: 'https://www.linkedin.com/in/max-werner-cs/',
    location: 'Braunschweig, DE',
  },
];
---

<section class="section" data-rule="bottom" aria-labelledby="team-label">
  <h2 class="section-label" id="team-label">Team</h2>
  <ul class="team-list">
    {members.map((member) => (
      <li class="team-item">
        <span class="team-name">
          {member.name}
          <a
            href={member.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="linkedin-link"
            aria-label={`${member.name} on LinkedIn (opens in a new tab)`}
          >
            <svg class="linkedin-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </span>
        <span class="team-meta">
          <span class="text-muted text-xs">{member.location}</span>
          <a
            href={`mailto:${member.email}`}
            class="text-xs"
            aria-label={`Email ${member.name}`}
          >{member.email}</a>
        </span>
      </li>
    ))}
  </ul>
</section>

<style>
  .team-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .team-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .team-item {
      row-gap: var(--space-1);
    }
  }

  .team-name {
    font-size: var(--font-size-base);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* WCAG 2.2 2.5.8 wants 24x24; the glyph is 12x12. Padding grows the hit
     area, the matching negative margin keeps the layout box the same size,
     so the icon sits exactly where it did. */
  .linkedin-link {
    color: var(--color-muted);
    display: inline-flex;
    align-items: center;
    padding: 6px;
    margin: -6px;
    transition: color 0.15s ease;
  }

  .linkedin-link:hover,
  .linkedin-link:focus-visible {
    color: var(--color-fg);
  }

  .linkedin-icon {
    width: 12px;
    height: 12px;
  }

  .team-meta {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-6);
    row-gap: var(--space-1);
    align-items: baseline;
  }

  .team-meta a {
    /* 18px of text -> a 24px-tall target (2.5.8). These links are flex items,
       so they are blockified and the padding would otherwise grow the row; the
       matching negative margin keeps the layout box, and the baseline, where
       they were. */
    padding-block: 3px;
    margin-block: -3px;

    /* With the root font-size now following the browser setting (1.4.4), an
       enlarged address is wide enough to push the page sideways at 320px.
       `anywhere` rather than `break-word`: these are flex items, and only
       `anywhere` lets the min-content width shrink below the longest word. */
    overflow-wrap: anywhere;
  }
</style>
