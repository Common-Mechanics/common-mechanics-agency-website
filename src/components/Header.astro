---
import Wordmark from './Wordmark.astro';
---

<header class="section header-section" data-rule="bottom">
  <Wordmark data-animate style="--stagger: 0" />
  <h1 class="tagline" data-animate style="--stagger: 1">The design and web partner for high-impact nonprofits.</h1>
</header>

<style>
  .header-section {
    padding-top: var(--space-24);
    padding-bottom: var(--space-16);
  }

  .tagline {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 7vw, 3.375rem);  /* shrinks smoothly below ~770px */
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.1;
    max-width: 16ch;
  }
</style>
