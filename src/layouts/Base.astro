---
// Self-hosted webfonts (Fontsource) — no third-party requests to Google's CDN.
// DM Sans: variable weight axis (registers the family as "DM Sans Variable"),
// covers the 300 / 400 / 700 the site uses. IBM Plex Mono: only the 400 and 500
// static weights in use, latin + latin-ext subsets.
import '@fontsource-variable/dm-sans';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-ext-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-ext-500.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Common Mechanics',
  description = 'Website design and build for AI safety organisations.',
} = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>
